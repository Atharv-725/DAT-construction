# Form Endpoint Configuration
# Example using Web3Forms: https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_KEY=YOUR_WEB3FORMS_ACCESS_KEY_HERE

# Alternative Providers:
# Formspree: PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
# Netlify Forms: Netlify handles forms via data-netlify="true" attribute automatically
