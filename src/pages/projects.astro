---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Compute tab counts dynamically from collection
const totalCount = allProjects.length;
const landscapingCount = allProjects.filter(p => p.data.sector === 'landscaping').length;
const waterCount = allProjects.filter(p => p.data.sector === 'water').length;
const civilCount = allProjects.filter(p => p.data.sector === 'civil').length;
const roadsCount = allProjects.filter(p => p.data.sector === 'roads').length;
const amcCount = allProjects.filter(p => p.data.sector === 'amc').length;
---

<Base title="Projects & Experience | DAT Construction" description="Browse executed civil, landscaping, water treatment, and infrastructure projects by DAT Construction in Indore, MP.">
  <div class="page-banner">
    <div class="section-container">
      <div class="breadcrumb">
        <a href="/">Home</a> <span>/</span> <strong>Projects</strong>
      </div>
      <h1>Project Registry & Contract History</h1>
      <p class="banner-sub">Documented project activity across institutional, municipal, and civil infrastructure domains.</p>
    </div>
  </div>

  <section class="section">
    <div class="section-container">
      <!-- Filter Tabs -->
      <div class="project-tabs" role="tablist" aria-label="Filter projects by sector">
        <button class="tab-btn active" role="tab" aria-selected="true" data-filter="all">All Projects ({totalCount})</button>
        {landscapingCount > 0 && <button class="tab-btn" role="tab" aria-selected="false" data-filter="landscaping">Landscaping ({landscapingCount})</button>}
        {waterCount > 0 && <button class="tab-btn" role="tab" aria-selected="false" data-filter="water">Water Systems ({waterCount})</button>}
        {civilCount > 0 && <button class="tab-btn" role="tab" aria-selected="false" data-filter="civil">Civil Works ({civilCount})</button>}
        {roadsCount > 0 && <button class="tab-btn" role="tab" aria-selected="false" data-filter="roads">Roads ({roadsCount})</button>}
        {amcCount > 0 && <button class="tab-btn" role="tab" aria-selected="false" data-filter="amc">AMC ({amcCount})</button>}
      </div>

      <div class="project-cards-grid">
        {allProjects.map(project => (
          <article class="project-card" data-category={project.data.sector}>
            <div class="card-top">
              <span class="dept-badge">{project.data.client}</span>
              {project.data.verified && project.data.sanctionedValue && (
                <span class="value-badge">{project.data.sanctionedValue}</span>
              )}
            </div>
            <h3>{project.data.title}</h3>
            <p>{project.data.scope}</p>
            {project.data.submissionDate && (
              <div class="card-meta">
                <span class="meta-label">Submission Date:</span> <strong>{project.data.submissionDate}</strong>
              </div>
            )}
            <div class="card-footer">
              {project.data.verified ? (
                <span class="status-pill verified">✓ Documented Award</span>
              ) : (
                <span class="status-pill pending">Under Client Review</span>
              )}
              {project.data.workOrderNo && (
                <span class="ref-no">Ref: {project.data.workOrderNo}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .project-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .tab-btn {
    padding: 10px 20px;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition);
  }
  .tab-btn:hover {
    border-color: var(--navy-deep);
    color: var(--navy-deep);
  }
  .tab-btn.active {
    background-color: var(--navy-deep);
    color: #FFFFFF;
    border-color: var(--navy-deep);
  }
  .project-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }
  .project-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 28px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: var(--transition), transform 0.2s ease, opacity 0.2s ease;
  }
  .project-card[hidden] {
    display: none !important;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .dept-badge {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--navy-deep);
    background-color: var(--bg-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }
  .value-badge {
    font-family: 'Manrope', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--gold-text);
  }
  .project-card h3 {
    font-size: 1.2rem;
    color: var(--navy-deep);
    margin-bottom: 12px;
  }
  .project-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 16px;
    flex-grow: 1;
  }
  .card-meta {
    margin-bottom: 20px;
    font-size: 0.82rem;
    background-color: var(--bg-subtle);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    display: inline-block;
    align-self: flex-start;
  }
  .meta-label {
    color: var(--text-muted);
  }
  .card-meta strong {
    color: var(--navy-deep);
  }
  .card-footer {
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
  }
  .status-pill.verified {
    color: #15803D;
    font-weight: 700;
  }
  .status-pill.pending {
    color: var(--text-light);
    font-weight: 600;
  }
  .ref-no {
    color: var(--text-light);
    font-family: monospace;
  }
</style>

<script>
  function setupProjectTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const cards = document.querySelectorAll('.project-card');

    if (!tabs.length || !cards.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.getAttribute('data-filter');
        cards.forEach(card => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            card.removeAttribute('hidden');
            (card as HTMLElement).style.display = 'flex';
          } else {
            card.setAttribute('hidden', 'true');
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  // Run on initial load and setup event listener
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectTabs);
  } else {
    setupProjectTabs();
  }
</script>
