---
import Base from '../layouts/Base.astro';
import { getCompanyData, hasRegistrations, hasCertifications } from '../lib/company';

const company = getCompanyData();
const showRegistrations = hasRegistrations(company);
const showCertifications = hasCertifications(company);
const isEmpty = !showRegistrations && !showCertifications;
---

<Base title="Company Credentials & Registrations | DAT Construction" description="Verified contractor registrations, statutory licenses, and quality certifications for DAT Construction in Indore, MP.">
  <div class="page-banner">
    <div class="section-container">
      <div class="breadcrumb"><a href="/">Home</a> <span>/</span> <strong>Credentials</strong></div>
      <h1>Credentials & Licenses</h1>
      <p class="banner-sub">Contractor registrations, statutory compliance numbers, and quality certifications.</p>
    </div>
  </div>

  <section class="section">
    <div class="section-container">
      {isEmpty ? (
        <div class="empty-state">
          <h2>No Public Credentials On File</h2>
          <p>Official registration certificates, contractor licenses, and quality certifications are pending client document verification before publication.</p>
        </div>
      ) : (
        <div class="credentials-grid">
          {showRegistrations && (
            <div class="cred-block">
              <h2>Contractor Registrations & Licenses</h2>
              <div class="cred-list">
                {company.registrations.map(reg => (
                  <div class="cred-card">
                    <strong>{reg.label}</strong>
                    <span class="cred-num">{reg.number}</span>
                    {reg.documentPath && (
                      <a href={reg.documentPath} target="_blank" rel="noopener noreferrer" class="doc-link">View Certificate PDF ↗</a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {showCertifications && (
            <div class="cred-block">
              <h2>Quality & Safety Certifications</h2>
              <div class="cred-list">
                {company.certifications.map(cert => (
                  <div class="cred-card">
                    <strong>{cert.name}</strong>
                    {cert.issuer && <span>Issuer: {cert.issuer}</span>}
                    {cert.validUntil && <span>Valid Until: {cert.validUntil}</span>}
                    {cert.documentPath && (
                      <a href={cert.documentPath} target="_blank" rel="noopener noreferrer" class="doc-link">View Certificate PDF ↗</a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    max-width: 640px;
    margin: 0 auto;
  }
  .empty-state h2 {
    color: var(--navy-deep);
    margin-bottom: 12px;
  }
  .empty-state p {
    color: var(--text-muted);
  }
  .credentials-grid {
    display: grid;
    gap: 40px;
  }
  .cred-block h2 {
    font-size: 1.5rem;
    color: var(--navy-deep);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--gold-primary);
  }
  .cred-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .cred-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 20px;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cred-card strong {
    color: var(--navy-deep);
    font-size: 1.05rem;
  }
  .cred-num {
    font-family: monospace;
    color: var(--gold-text);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .doc-link {
    font-size: 0.85rem;
    color: var(--gold-text);
    font-weight: 700;
    margin-top: 8px;
  }
</style>
