---
import Base from '../layouts/Base.astro';
import { getCompanyData } from '../lib/company';

const company = getCompanyData();
---

<Base title="Customer Portal & Authentication | DAT Construction" description="Create an account or log in to access DAT Construction's official website, project portfolio, and quote requests.">
  <div class="auth-page">
    <div class="auth-container">
      
      <!-- Left Column: Branding & Customer Benefits -->
      <div class="auth-info">
        <div class="brand-badge">
          <span class="govt-pill">REGISTERED INFRASTRUCTURE CONTRACTOR</span>
        </div>

        <h1>Welcome to DAT Construction Portal</h1>
        <p class="auth-lead">
          Please create an account using your email address and password to access our full civil engineering portfolio, equipment safety standards, and project estimation tools.
        </p>

        <div class="features-list">
          <div class="feature-item">
            <div class="feature-icon">🏗️</div>
            <div>
              <h3>Civil & Infrastructure Catalog</h3>
              <p>Explore detailed technical scopes for RCC structures, water plants (STP), and road construction.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">📄</div>
            <div>
              <h3>Instant Quote Estimations</h3>
              <p>Submit direct project proposals and track response status with our engineering team.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">🛡️</div>
            <div>
              <h3>Verified Credentials</h3>
              <p>Access official PWD MP registrations, GST compliance, and safety certifications.</p>
            </div>
          </div>
        </div>

        <div class="trust-footer">
          <span>Serving Indore & Madhya Pradesh | Rajendra Nagar, Indore</span>
        </div>
      </div>

      <!-- Right Column: Interactive Login / Signup Form -->
      <div class="auth-card">
        <div class="auth-card-header">
          <div class="auth-tabs" role="tablist">
            <button type="button" class="tab-btn active" id="tabSignup" role="tab" aria-selected="true" aria-controls="panelSignup">
              Create Account
            </button>
            <button type="button" class="tab-btn" id="tabLogin" role="tab" aria-selected="false" aria-controls="panelLogin">
              Sign In
            </button>
          </div>
        </div>

        <div class="auth-card-body">
          <div id="alertBox" class="alert hidden" role="alert"></div>

          <!-- SIGN UP PANEL -->
          <form id="signupForm" class="auth-form">
            <div class="form-header">
              <h2>Create Customer Account</h2>
              <p>Enter your details below to register and access the website.</p>
            </div>

            <div class="form-group">
              <label for="signupName">Full Name / Organization</label>
              <div class="input-wrapper">
                <input type="text" id="signupName" name="fullName" placeholder="e.g. Rajesh Kumar or Zenith Infra Ltd" required autocomplete="name" />
                <span class="input-icon">👤</span>
              </div>
            </div>

            <div class="form-group">
              <label for="signupEmail">Email Address <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="email" id="signupEmail" name="email" placeholder="customer@example.com" required autocomplete="email" />
                <span class="input-icon">✉️</span>
              </div>
            </div>

            <div class="form-group">
              <label for="signupPassword">Password <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="password" id="signupPassword" name="password" placeholder="Minimum 6 characters" required minlength="6" autocomplete="new-password" />
                <button type="button" class="toggle-password" data-target="signupPassword" aria-label="Toggle password visibility">👁️</button>
              </div>
            </div>

            <div class="form-group">
              <label for="signupConfirmPassword">Confirm Password <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="password" id="signupConfirmPassword" name="confirmPassword" placeholder="Re-enter your password" required minlength="6" autocomplete="new-password" />
                <button type="button" class="toggle-password" data-target="signupConfirmPassword" aria-label="Toggle password visibility">👁️</button>
              </div>
            </div>

            <div class="form-terms">
              <label class="checkbox-label">
                <input type="checkbox" id="agreeTerms" required checked />
                <span>I agree to DAT Construction terms and privacy guidelines.</span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="btnSignupSubmit">
              <span class="btn-text">Create Account & Access Website ↗</span>
              <span class="btn-spinner hidden"></span>
            </button>

            <p class="form-switch-note">
              Already registered? <button type="button" class="link-btn" id="switchToLogin">Sign in here</button>
            </p>
          </form>

          <!-- LOGIN PANEL -->
          <form id="loginForm" class="auth-form hidden">
            <div class="form-header">
              <h2>Customer Sign In</h2>
              <p>Welcome back! Log in using your registered email and password.</p>
            </div>

            <div class="form-group">
              <label for="loginEmail">Email Address <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="email" id="loginEmail" name="email" placeholder="customer@example.com" required autocomplete="email" />
                <span class="input-icon">✉️</span>
              </div>
            </div>

            <div class="form-group">
              <label for="loginPassword">Password <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="password" id="loginPassword" name="password" placeholder="Enter your password" required autocomplete="current-password" />
                <button type="button" class="toggle-password" data-target="loginPassword" aria-label="Toggle password visibility">👁️</button>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="btnLoginSubmit">
              <span class="btn-text">Sign In & Access Website ↗</span>
              <span class="btn-spinner hidden"></span>
            </button>

            <p class="form-switch-note">
              Need a customer account? <button type="button" class="link-btn" id="switchToSignup">Create account now</button>
            </p>
          </form>

        </div>
      </div>

    </div>
  </div>
</Base>

<script>
  // DOM Elements
  const tabSignup = document.getElementById('tabSignup');
  const tabLogin = document.getElementById('tabLogin');
  const signupForm = document.getElementById('signupForm') as HTMLFormElement;
  const loginForm = document.getElementById('loginForm') as HTMLFormElement;
  const switchToLogin = document.getElementById('switchToLogin');
  const switchToSignup = document.getElementById('switchToSignup');
  const alertBox = document.getElementById('alertBox');

  // URL Query Mode Check (e.g. ?mode=login or ?mode=signup)
  const urlParams = new URLSearchParams(window.location.search);
  const modeParam = urlParams.get('mode');
  const redirectUrl = urlParams.get('redirect') || '/';

  function showAlert(message: string, type: 'error' | 'success' | 'info') {
    if (!alertBox) return;
    alertBox.textContent = message;
    alertBox.className = `alert alert-${type}`;
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideAlert() {
    if (!alertBox) return;
    alertBox.className = 'alert hidden';
    alertBox.textContent = '';
  }

  function activateTab(tab: 'signup' | 'login') {
    hideAlert();
    if (tab === 'signup') {
      tabSignup?.classList.add('active');
      tabSignup?.setAttribute('aria-selected', 'true');
      tabLogin?.classList.remove('active');
      tabLogin?.setAttribute('aria-selected', 'false');
      signupForm?.classList.remove('hidden');
      loginForm?.classList.add('hidden');
    } else {
      tabLogin?.classList.add('active');
      tabLogin?.setAttribute('aria-selected', 'true');
      tabSignup?.classList.remove('active');
      tabSignup?.setAttribute('aria-selected', 'false');
      loginForm?.classList.remove('hidden');
      signupForm?.classList.add('hidden');
    }
  }

  if (modeParam === 'login') {
    activateTab('login');
  }

  tabSignup?.addEventListener('click', () => activateTab('signup'));
  tabLogin?.addEventListener('click', () => activateTab('login'));
  switchToLogin?.addEventListener('click', () => activateTab('login'));
  switchToSignup?.addEventListener('click', () => activateTab('signup'));

  // Password Visibility Toggle
  document.querySelectorAll('.toggle-password').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const targetId = (e.currentTarget as HTMLElement).getAttribute('data-target');
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement;
      if (input) {
        if (input.type === 'password') {
          input.type = 'text';
          (e.currentTarget as HTMLElement).textContent = '🙈';
        } else {
          input.type = 'password';
          (e.currentTarget as HTMLElement).textContent = '👁️';
        }
      }
    });
  });

  // Save session to localStorage & Cookies for client-side gating
  function setCustomerSession(user: any) {
    const sessionData = {
      email: user.email,
      fullName: user.fullName,
      token: user.token,
      loginTime: Date.now()
    };
    localStorage.setItem('dat_customer_session', JSON.stringify(sessionData));
    // Set a cookie valid for 30 days
    document.cookie = `dat_customer_token=${user.token}; path=/; max-age=${30 * 24 * 60 * 60}; SameSite=Lax`;
  }

  // Handle Signup Form Submission
  signupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const fullName = (document.getElementById('signupName') as HTMLInputElement).value.trim();
    const email = (document.getElementById('signupEmail') as HTMLInputElement).value.trim();
    const password = (document.getElementById('signupPassword') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('signupConfirmPassword') as HTMLInputElement).value;
    const btnSubmit = document.getElementById('btnSignupSubmit') as HTMLButtonElement;

    if (password !== confirmPassword) {
      showAlert('Passwords do not match. Please re-type your password.', 'error');
      return;
    }

    if (password.length < 6) {
      showAlert('Password must be at least 6 characters long.', 'error');
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.querySelector('.btn-text')?.classList.add('hidden');
    btnSubmit.querySelector('.btn-spinner')?.classList.remove('hidden');

    try {
      const response = await fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName, email, password })
      });

      const result = await response.json();

      if (response.ok && result.success) {
        setCustomerSession(result.user);
        showAlert('Account created successfully! Redirecting to website...', 'success');
        setTimeout(() => {
          window.location.href = redirectUrl;
        }, 900);
      } else {
        showAlert(result.error || 'Failed to create account.', 'error');
      }
    } catch (err) {
      showAlert('Network error. Please check your internet connection and try again.', 'error');
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.querySelector('.btn-text')?.classList.remove('hidden');
      btnSubmit.querySelector('.btn-spinner')?.classList.add('hidden');
    }
  });

  // Handle Login Form Submission
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const email = (document.getElementById('loginEmail') as HTMLInputElement).value.trim();
    const password = (document.getElementById('loginPassword') as HTMLInputElement).value;
    const btnSubmit = document.getElementById('btnLoginSubmit') as HTMLButtonElement;

    btnSubmit.disabled = true;
    btnSubmit.querySelector('.btn-text')?.classList.add('hidden');
    btnSubmit.querySelector('.btn-spinner')?.classList.remove('hidden');

    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const result = await response.json();

      if (response.ok && result.success) {
        setCustomerSession(result.user);
        showAlert('Signed in successfully! Redirecting...', 'success');
        setTimeout(() => {
          window.location.href = redirectUrl;
        }, 800);
      } else {
        showAlert(result.error || 'Invalid email or password.', 'error');
      }
    } catch (err) {
      showAlert('Network error. Please check your internet connection.', 'error');
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.querySelector('.btn-text')?.classList.remove('hidden');
      btnSubmit.querySelector('.btn-spinner')?.classList.add('hidden');
    }
  });

  // Check if user is already logged in upon visiting /login
  try {
    const rawSession = localStorage.getItem('dat_customer_session');
    if (rawSession) {
      const session = JSON.parse(rawSession);
      if (session && session.email && session.token) {
        showAlert(`You are already signed in as ${session.email}. Redirecting...`, 'info');
        setTimeout(() => {
          window.location.href = redirectUrl;
        }, 1000);
      }
    }
  } catch (e) {
    // Ignore JSON error
  }
</script>

<style>
  .auth-page {
    background: linear-gradient(135deg, #060E1A 0%, #0F2537 50%, #1E293B 100%);
    min-height: calc(100vh - 80px);
    padding: 60px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
  }

  .auth-container {
    max-width: 1140px;
    width: 100%;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  /* Left Branding Side */
  .auth-info {
    padding-right: 20px;
  }

  .govt-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.15);
    border: 1px solid var(--gold-primary);
    color: var(--gold-primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 24px;
  }

  .auth-info h1 {
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    color: #FFFFFF;
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .auth-lead {
    font-size: 1.05rem;
    color: #CBD5E1;
    line-height: 1.6;
    margin-bottom: 36px;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 36px;
  }

  .feature-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 16px 20px;
    border-radius: var(--radius-md);
    backdrop-filter: blur(10px);
  }

  .feature-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .feature-item h3 {
    font-size: 1.05rem;
    color: #FFFFFF;
    margin-bottom: 4px;
  }

  .feature-item p {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.4;
  }

  .trust-footer {
    font-size: 0.82rem;
    color: #64748B;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 16px;
  }

  /* Right Auth Card */
  .auth-card {
    background: #FFFFFF;
    color: var(--text-primary);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .auth-card-header {
    background: #F8FAFC;
    border-bottom: 1px solid var(--border-color);
  }

  .auth-tabs {
    display: flex;
  }

  .tab-btn {
    flex: 1;
    padding: 18px 12px;
    background: transparent;
    border: none;
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition);
    border-bottom: 3px solid transparent;
  }

  .tab-btn:hover {
    color: var(--navy-deep);
    background: rgba(0, 0, 0, 0.02);
  }

  .tab-btn.active {
    color: var(--navy-deep);
    background: #FFFFFF;
    border-bottom-color: var(--gold-primary);
  }

  .auth-card-body {
    padding: 32px;
  }

  .form-header {
    margin-bottom: 24px;
  }

  .form-header h2 {
    font-size: 1.4rem;
    color: var(--navy-deep);
    margin-bottom: 6px;
  }

  .form-header p {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--navy-deep);
    margin-bottom: 6px;
  }

  .required {
    color: #E11D48;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-wrapper input {
    width: 100%;
    padding: 12px 42px 12px 14px;
    font-size: 0.95rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: #F8FAFC;
    color: var(--text-primary);
    transition: var(--transition);
  }

  .input-wrapper input:focus {
    background: #FFFFFF;
    border-color: var(--navy-deep);
    box-shadow: 0 0 0 3px rgba(11, 25, 44, 0.1);
  }

  .input-icon {
    position: absolute;
    right: 14px;
    pointer-events: none;
    font-size: 1.1rem;
    opacity: 0.6;
  }

  .toggle-password {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 4px 6px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .toggle-password:hover {
    opacity: 1;
  }

  .form-terms {
    margin-bottom: 24px;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.82rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 3px;
    cursor: pointer;
  }

  .btn-block {
    width: 100%;
    padding: 14px;
    font-size: 1rem;
  }

  .btn-spinner {
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: #FFFFFF;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .form-switch-note {
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 20px;
  }

  .link-btn {
    background: transparent;
    border: none;
    color: var(--gold-text);
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    font-size: inherit;
  }

  .link-btn:hover {
    color: var(--navy-deep);
  }

  /* Alerts */
  .alert {
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .alert-error {
    background: #FFE4E6;
    color: #9F1239;
    border: 1px solid #FECDD3;
  }

  .alert-success {
    background: #DCFCE7;
    color: #166534;
    border: 1px solid #BBF7D0;
  }

  .alert-info {
    background: #E0F2FE;
    color: #075985;
    border: 1px solid #BAE6FD;
  }

  .hidden {
    display: none !important;
  }

  /* Responsive styling */
  @media (max-width: 900px) {
    .auth-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .auth-info {
      padding-right: 0;
    }

    .auth-info h1 {
      font-size: 2.2rem;
    }
  }

  @media (max-width: 500px) {
    .auth-page {
      padding: 32px 16px;
    }

    .auth-card-body {
      padding: 20px 16px;
    }
  }
</style>
