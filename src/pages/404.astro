---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | DAT Construction" description="The requested page could not be found.">
  <section class="section">
    <div class="section-container error-content">
      <h1>404 — Page Not Found</h1>
      <p>The page you are looking for does not exist or has been moved.</p>
      <a href="/" class="btn btn-primary">Return to Homepage ↗</a>
    </div>
  </section>
</Base>

<style>
  .error-content {
    text-align: center;
    padding: 80px 20px;
    max-width: 600px;
    margin: 0 auto;
  }
  .error-content h1 {
    font-size: 2.5rem;
    color: var(--navy-deep);
    margin-bottom: 16px;
  }
  .error-content p {
    color: var(--text-muted);
    margin-bottom: 32px;
  }
</style>
