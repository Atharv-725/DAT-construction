---
import Base from '../layouts/Base.astro';
import { getCompanyData, hasEmail } from '../lib/company';

const company = getCompanyData();
---

<Base title="Careers & Recruitment | DAT Construction" description="Join our site engineering, project management, and site supervision team in Indore, MP.">
  <div class="page-banner">
    <div class="section-container">
      <div class="breadcrumb"><a href="/">Home</a> <span>/</span> <strong>Careers</strong></div>
      <h1>Careers & Opportunities</h1>
      <p class="banner-sub">Opportunities for civil engineers, site supervisors, equipment operators, and project managers.</p>
    </div>
  </div>

  <section class="section">
    <div class="section-container">
      <div class="careers-box">
        <h2>Join Our Engineering Team</h2>
        <p>DAT Construction is always looking for qualified site supervisors, civil engineers, plumbers, STP technicians, and heavy equipment operators based in Indore and the Malwa region.</p>
        
        {hasEmail(company) ? (
          <div class="apply-card">
            <h3>How to Apply</h3>
            <p>Send your resume and project experience details to:</p>
            <a href={`mailto:${company.email}?subject=Career%20Application%20-%20DAT%20Construction`} class="btn btn-primary">
              Email Resume to {company.email} ↗
            </a>
          </div>
        ) : (
          <div class="apply-card">
            <h3>How to Apply</h3>
            <p>Applications can be submitted directly at our Rajendra Nagar office in Indore, MP.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .careers-box {
    max-width: 800px;
    margin: 0 auto;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 40px;
    border-radius: var(--radius-md);
  }
  .careers-box h2 {
    color: var(--navy-deep);
    margin-bottom: 16px;
  }
  .careers-box p {
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.6;
  }
  .apply-card {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    padding: 24px;
    border-radius: var(--radius-sm);
  }
  .apply-card h3 {
    color: var(--navy-deep);
    margin-bottom: 8px;
  }
</style>
