---
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '../styles/global.css';

import { getCompanyData, hasPhone, hasEmail, hasAddress, hasRegistrations, hasCertifications } from '../lib/company';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const company = getCompanyData();
const {
  title = `${company.displayName || 'DAT Construction'} | Civil Engineering & Infrastructure Contractor | Indore`,
  description = company.tagline || 'DAT Construction delivers civil engineering, infrastructure, water treatment, and facility maintenance works in Indore, Madhya Pradesh.',
  ogImage = '/og-image.jpg',
  canonicalUrl = Astro.url.href
} = Astro.props;

const currentPath = Astro.url.pathname;
const showTopBar = hasPhone(company) || hasRegistrations(company) || hasCertifications(company);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(ogImage, Astro.url)}>

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalUrl}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={new URL(ogImage, Astro.url)}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Instant Client-side Access Guard -->
  <script is:inline>
    (function() {
      var path = window.location.pathname;
      // Allow auth page, api routes, and 404
      if (path === '/login' || path.startsWith('/login/') || path.startsWith('/api/') || path === '/404') {
        return;
      }
      var session = localStorage.getItem('dat_customer_session');
      if (!session) {
        var currentUrl = window.location.pathname + window.location.search;
        window.location.replace('/login?redirect=' + encodeURIComponent(currentUrl));
      }
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>

  {showTopBar && (
    <div class="top-bar">
      <div class="top-bar-inner">
        <div class="top-bar-left">
          {hasRegistrations(company) && (
            <span class="govt-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V7l-9-5zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 9z"/></svg>
              {company.registrations[0].label}: {company.registrations[0].number}
            </span>
          )}
          {hasAddress(company) && (
            <span>{company.address.city}, {company.address.state}</span>
          )}
        </div>
        <div class="top-bar-right">
          {hasCertifications(company) && (
            <span>{company.certifications[0].name}</span>
          )}
          {hasPhone(company) && (
            <a href={`tel:${company.phone.dial}`}>📞 {company.phone.display}</a>
          )}
        </div>
      </div>
    </div>
  )}

  <header class="nav">
    <a class="brand" href="/" aria-label="DAT Construction Home">
      <div class="brand-crest">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">{company.displayName || 'DAT CONSTRUCTION'}</span>
        <span class="brand-sub">CIVIL & INFRASTRUCTURE CONTRACTOR</span>
      </div>
    </a>

    <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="primaryNav">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav-links" id="primaryNav">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
      <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
      <a href="/services" aria-current={currentPath === '/services' ? 'page' : undefined}>Services</a>
      <a href="/projects" aria-current={currentPath === '/projects' ? 'page' : undefined}>Projects</a>
      <a href="/equipment-safety" aria-current={currentPath === '/equipment-safety' ? 'page' : undefined}>Equipment & Safety</a>
      <a href="/contact" class="nav-cta" aria-current={currentPath === '/contact' ? 'page' : undefined}>Get a Quote</a>

      <!-- Unauthenticated customer portal link -->
      <a href="/login" id="navAuthLink" class="nav-auth-item">Customer Portal</a>

      <!-- Logged in Customer Pill with Avatar + 3 lines icon + Dropdown Menu -->
      <div id="userAccountMenu" class="user-account-wrapper hidden">
        <button id="accountMenuBtn" class="account-menu-pill" type="button" aria-expanded="false" aria-label="Customer Account menu">
          <div class="avatar-circle" id="userAvatarCircle">A</div>
          <svg class="menu-bars-icon" width="18" height="14" viewBox="0 0 18 14" fill="currentColor">
            <rect y="0" width="18" height="2" rx="1" />
            <rect y="6" width="18" height="2" rx="1" />
            <rect y="12" width="18" height="2" rx="1" />
          </svg>
        </button>

        <div id="accountDropdown" class="account-dropdown hidden" style="display: none;" role="menu">
          <div class="dropdown-user-info">
            <strong id="dropdownUserName">Customer Account</strong>
            <small id="dropdownUserEmail">user@example.com</small>
          </div>

          <div class="dropdown-list">
            <!-- Active / Dashboard item -->
            <a href="/" class={`menu-list-item ${currentPath === '/' ? 'active' : ''}`} role="menuitem">
              <svg class="menu-item-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 13h6a1 1 0 001-1V4a1 1 0 00-1-1H4a1 1 0 00-1 1v8a1 1 0 001 1zm0 8h6a1 1 0 001-1v-4a1 1 0 00-1-1H4a1 1 0 00-1 1v4a1 1 0 001 1zm10 0h6a1 1 0 001-1v-8a1 1 0 00-1-1h-6a1 1 0 00-1 1v8a1 1 0 001 1zm0-18v4a1 1 0 001 1h6a1 1 0 001-1V4a1 1 0 00-1-1h-6a1 1 0 00-1 1z"/>
              </svg>
              <span>Dashboard</span>
            </a>

            <!-- Profile item -->
            <a href="/about" class={`menu-list-item ${currentPath === '/about' ? 'active' : ''}`} role="menuitem">
              <svg class="menu-item-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <span>Profile</span>
            </a>

            <!-- Send Transcript / Quote Requests item -->
            <a href="/contact" class={`menu-list-item ${currentPath === '/contact' ? 'active' : ''}`} role="menuitem">
              <svg class="menu-item-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
              <span>Send Transcript</span>
            </a>

            <div class="menu-divider"></div>

            <!-- Settings item -->
            <a href="/credentials" class={`menu-list-item ${currentPath === '/credentials' ? 'active' : ''}`} role="menuitem">
              <svg class="menu-item-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/>
              </svg>
              <span>Settings</span>
            </a>

            <!-- Sign Out item -->
            <button type="button" class="menu-list-item global-logout-btn" role="menuitem">
              <svg class="menu-item-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span>Sign Out</span>
            </button>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <WhatsAppButton />

  <footer class="official-footer">
    <div class="footer-container">
      <div class="footer-top">
        <div class="footer-brand">
          <div class="brand-crest">DAT</div>
          <div>
            <strong>{company.legalName || 'DAT CONSTRUCTION'}</strong>
            <small>Civil Engineering & Infrastructure Contractor</small>
          </div>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/services">Services</a>
          <a href="/projects">Projects</a>
          <a href="/equipment-safety">Equipment & Safety</a>
          <a href="/credentials">Credentials</a>
          <a href="/team">Team</a>
          <a href="/careers">Careers</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy Notice</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>

      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} {company.displayName || 'DAT Construction'}. All rights reserved.</p>
        {hasAddress(company) && (
          <p>{company.address.line1}, {company.address.city}, {company.address.state} {company.address.pincode}</p>
        )}
      </div>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById('menuToggle');
    const primaryNav = document.getElementById('primaryNav');

    if (menuToggle && primaryNav) {
      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
        primaryNav.classList.toggle('open');
        menuToggle.classList.toggle('open');
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (primaryNav.classList.contains('open') && !primaryNav.contains(target) && !menuToggle.contains(target)) {
          primaryNav.classList.remove('open');
          menuToggle.classList.remove('open');
          menuToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Dynamic User Auth UI & Account Dropdown Menu Handler
    const navAuthLink = document.getElementById('navAuthLink');
    const userAccountMenu = document.getElementById('userAccountMenu');
    const userAvatarCircle = document.getElementById('userAvatarCircle');
    const dropdownUserName = document.getElementById('dropdownUserName');
    const dropdownUserEmail = document.getElementById('dropdownUserEmail');
    const accountMenuBtn = document.getElementById('accountMenuBtn');
    const accountDropdown = document.getElementById('accountDropdown');

    try {
      const rawSession = localStorage.getItem('dat_customer_session');
      if (rawSession) {
        const session = JSON.parse(rawSession);
        if (session && session.email) {
          const nameToUse = session.fullName || session.email;
          const initial = nameToUse.trim().charAt(0).toUpperCase();

          if (userAvatarCircle) userAvatarCircle.textContent = initial;
          if (dropdownUserName) dropdownUserName.textContent = session.fullName || session.email.split('@')[0];
          if (dropdownUserEmail) dropdownUserEmail.textContent = session.email;

          if (navAuthLink) navAuthLink.classList.add('hidden');
          if (userAccountMenu) userAccountMenu.classList.remove('hidden');
        }
      }
    } catch (e) {
      // Session parse error fallback
    }

    // Toggle dropdown on account pill click
    if (accountMenuBtn && accountDropdown) {
      accountMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isShown = accountDropdown.classList.contains('show');
        if (!isShown) {
          accountDropdown.classList.add('show');
          accountDropdown.classList.remove('hidden');
          accountDropdown.style.display = 'block';
          accountMenuBtn.setAttribute('aria-expanded', 'true');
        } else {
          accountDropdown.classList.remove('show');
          accountDropdown.classList.add('hidden');
          accountDropdown.style.display = 'none';
          accountMenuBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (userAccountMenu && !userAccountMenu.contains(target)) {
          accountDropdown.classList.remove('show');
          accountDropdown.classList.add('hidden');
          accountDropdown.style.display = 'none';
          accountMenuBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Attach click listener to all global Sign Out buttons
    document.querySelectorAll('.global-logout-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        localStorage.removeItem('dat_customer_session');
        document.cookie = 'dat_customer_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;';
        window.location.href = '/login';
      });
    });
  </script>
</body>
</html>
